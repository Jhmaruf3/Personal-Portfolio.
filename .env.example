# ---------------------------------------------------------------------------
# Optional email configuration for the contact form (see README.md).
# Copy this file to ".env" and fill in your real values, then load the
# variables into your terminal before running the app. NEVER commit .env.
#
# Quick way to load on Windows (PowerShell):
#   Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim(), 'Process') } }
# ---------------------------------------------------------------------------

# Set to 1 (or "true"/"yes") to send real emails. Leave unset for demo mode,
# in which messages are validated and logged to the terminal but not sent.
SMTP_ENABLED=0

# Example with Gmail (you should use an App Password, not your real password):
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=your-email@gmail.com
#SMTP_PASS=your-app-password
#SMTP_TO=your-email@gmail.com

# Optional: a fixed secret key for sessions (otherwise a random one is
# generated on every start, which is fine for local development).
#SECRET_KEY=change-me-to-a-long-random-string
